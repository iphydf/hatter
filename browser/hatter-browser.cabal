cabal-version:      3.0

name:           hatter-browser
version:        0.1.0
category:       Mobile
synopsis:       Run Hatter apps in a browser
description:
  A Hatter platform for browsers: the app runs as WebAssembly, and the
  Angular host in host/ shows its widgets as Angular Material components.
license:        MIT
build-type:     Simple

common common-options
  ghc-options:
    -Wall -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Widentities -Wredundant-constraints -Wunused-packages
  default-language: Haskell2010

library
  import: common-options
  exposed-modules:
      Hatter.Browser
  hs-source-dirs:
      src
  c-sources:
      cbits/browser_bridge.c
  if !arch(wasm32)
    buildable: False
  build-depends:
      base <5,
      bytestring,
      ghc-experimental,
      hatter,
      text

-- The host runs it as app.wasm (see build.sh).
executable hatter-browser-demo
  import: common-options
  main-is: Main.hs
  hs-source-dirs:
      demo
  ghc-options:
    -no-hs-main -optl-mexec-model=reactor
    -optl-Wl,--export=hs_init,--export=start
  if !arch(wasm32)
    buildable: False
  build-depends:
      base <5,
      bytestring,
      hatter,
      hatter-browser,
      text
