cabal-version:      3.0

name:           hatter-terminal
version:        0.1.0
category:       Mobile
synopsis:       Run Hatter apps in a terminal
description:
  A Hatter platform that draws an app's widgets in a terminal, with brick,
  for using and testing apps on a desktop.
license:        MIT
build-type:     Simple
extra-source-files:
    test/bomb.png

common common-options
  ghc-options:
    -Wall -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Widentities -Wredundant-constraints -Wunused-packages
  default-language: Haskell2010

library
  import: common-options
  exposed-modules:
      Hatter.Terminal
      Hatter.Terminal.Draw
      Hatter.Terminal.Layout
      Hatter.Terminal.Platform
  hs-source-dirs:
      src
  c-sources:
      cbits/terminal_bridge.c
  build-depends:
      base <5,
      base64-bytestring,
      brick >=2 && <3,
      bytestring,
      case-insensitive,
      containers,
      directory,
      filepath,
      hatter,
      http-client,
      http-client-tls,
      http-types,
      JuicyPixels,
      mtl,
      process,
      text,
      time,
      unix,
      vector,
      vty >=6 && <7,
      vty-crossplatform

test-suite unit
  import: common-options
  type: exitcode-stdio-1.0
  main-is: Test.hs
  hs-source-dirs:
      test
  -- A picture decoded whole would need gigabytes.
  ghc-options: -threaded -rtsopts "-with-rtsopts=-M512m"
  build-depends:
      base <5,
      bytestring,
      filepath,
      hatter,
      hatter-terminal,
      JuicyPixels,
      temporary,
      tasty,
      tasty-hunit,
      text
